{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fontem.eu/v1/entities/UpsertCompany.json",
  "title": "UpsertCompany",
  "description": "A legal entity from any source (GLEIF, EDGAR, EU listings, etc.). The gmr_id is canonical and stable across sources; producers compute it from a hard ID (LEI, CIK, VAT) or a name+country last-resort. Source-specific fields ride along but most properties are optional.",
  "type": "object",
  "required": ["gmr_id"],
  "properties": {
    "gmr_id":  { "type": "string", "format": "uuid" },
    "name":    { "type": ["string", "null"] },
    "country": { "type": ["string", "null"], "description": "ISO 3166-1 alpha-2." },
    "lei":     { "type": ["string", "null"], "minLength": 20, "maxLength": 20 },
    "vat":     { "type": ["string", "null"] },
    "cik":     { "type": ["string", "null"] },
    "active":  { "type": ["boolean", "null"] },
    "legal_form":  { "type": ["string", "null"] },
    "postal_code": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
