{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fontem.eu/v1/control/EndGraphReplace.json",
  "title": "EndGraphReplace",
  "description": "Closes the BeginGraphReplace bracket for the same graph_iri. Sinks flush the buffered upserts here.",
  "type": "object",
  "required": ["graph_iri"],
  "properties": {
    "graph_iri": {
      "type": "string",
      "format": "uri"
    },
    "domain": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
