{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fontem.eu/v1/entities/UpsertFiling.json",
  "title": "UpsertFiling",
  "description": "A financial Filing (annual XBRL report). EDGAR (US 10-K/20-F/40-F) and ESEF (EU) share this shape; the source is on the event itself. Properties are sparse — every numeric field is optional because real XBRL is incomplete in the wild. The Virtuoso sink writes one fontem:Filing per event into the per-source graph (financials/edgar or financials/esef); the Neo4j sink MERGEs a :FinancialYear keyed on (gmr_id, year, source).",
  "type": "object",
  "required": ["gmr_id", "year", "source"],
  "properties": {
    "gmr_id":  { "type": "string", "format": "uuid" },
    "year":    { "type": "integer", "minimum": 1900, "maximum": 2100 },
    "source":  { "type": "string", "enum": ["edgar", "esef", "gleif"] },
    "filing_date": { "type": "string", "format": "date" },
    "revenue":              { "type": ["number", "null"] },
    "gross_profit":         { "type": ["number", "null"] },
    "operating_income":     { "type": ["number", "null"] },
    "net_income":           { "type": ["number", "null"] },
    "eps":                  { "type": ["number", "null"] },
    "total_assets":         { "type": ["number", "null"] },
    "total_liabilities":    { "type": ["number", "null"] },
    "equity":               { "type": ["number", "null"] },
    "cash_and_equivalents": { "type": ["number", "null"] },
    "cash":                 { "type": ["number", "null"] },
    "capex":                { "type": ["number", "null"] },
    "operating_cashflow":   { "type": ["number", "null"] },
    "free_cashflow":        { "type": ["number", "null"] },
    "current_assets":       { "type": ["number", "null"] },
    "current_liabilities":  { "type": ["number", "null"] },
    "shares_outstanding":   { "type": ["number", "null"] },
    "long_term_debt":       { "type": ["number", "null"] },
    "interest_expense":     { "type": ["number", "null"] },
    "income_tax_expense":   { "type": ["number", "null"] },
    "depreciation_amortization": { "type": ["number", "null"] },
    "inventory":            { "type": ["number", "null"] }
  },
  "additionalProperties": false
}
